# Copy to .env and fill in. Do NOT commit .env.
# Home Assistant WebSocket URL (the hub) + a long-lived access token.
HA_WS_URL=ws://192.168.1.39:8123/api/websocket
HA_TOKEN=

# Cogent Cloud target + account API key (sent as the APIKey header).
CLOUD_BASE_URL=https://api.cogentlog.io
CLOUD_API_KEY=

# Identity + what to stream.
HUB_ID=Hub1
INCLUDE_DOMAINS=sensor,binary_sensor,switch,light
EXCLUDE_ENTITIES=
SEND_ATTRIBUTES=true
BATCH_SIZE=50
FLUSH_INTERVAL_SECONDS=10
MAX_SPOOL_EVENTS=50000
LOG_LEVEL=info
